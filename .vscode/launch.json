{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug RTK",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build RTK",
      "args": [
        "${input:rtkConfigPath}"
      ],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/linux/rtk",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "linux": {
        "program": "${workspaceFolder}/build/linux/rtk",
        "miDebuggerPath": "/usr/bin/gdb"
      },
      "windows": {
        "program": "${workspaceFolder}/build/windows/rtk.exe",
        "miDebuggerPath": "D:/Environment/mingw64/bin/gdb.exe",
        "externalConsole": true
      }
    }
  ],
  "inputs": [
    {
      "id": "rtkConfigPath",
      "type": "promptString",
      "description": "输入RTK配置文件路径（绝对路径，或相对于项目根目录）"
    }
  ]
}
